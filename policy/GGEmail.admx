<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="ggemail" namespace="GGEmail.Mail" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <categories>
    <category name="GGEmail" displayName="$(string.GGEmail)" />
    <category name="GGEmail_Accounts" displayName="$(string.GGEmail_Accounts)">
      <parentCategory ref="GG Email" />
    </category>
    <category name="GGEmail_Updates" displayName="$(string.GGEmail_Updates)">
      <parentCategory ref="GG Email" />
    </category>
    <category name="GGEmail_Security" displayName="$(string.GGEmail_Security)">
      <parentCategory ref="GG Email" />
    </category>
    <category name="GGEmail_Storage" displayName="$(string.GGEmail_Storage)">
      <parentCategory ref="GG Email" />
    </category>
    <category name="GGEmail_Interface" displayName="$(string.GGEmail_Interface)">
      <parentCategory ref="GG Email" />
    </category>
    <category name="GGEmail_Diagnostics" displayName="$(string.GGEmail_Diagnostics)">
      <parentCategory ref="GG Email" />
    </category>
  </categories>
  <policies>
    <policy name="AutoconfigUrl" class="Both" displayName="$(string.AutoconfigUrl)" explainText="$(string.AutoconfigUrl_Help)" presentation="$(presentation.AutoconfigUrl)" key="SOFTWARE\Policies\GGEmail" valueName="AutoconfigUrl">
      <parentCategory ref="GGEmail_Accounts" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <text id="AutoconfigUrl_Value" valueName="AutoconfigUrl" required="false" />
      </elements>
    </policy>
    <policy name="PreconfiguredAccounts" class="Both" displayName="$(string.PreconfiguredAccounts)" explainText="$(string.PreconfiguredAccounts_Help)" presentation="$(presentation.PreconfiguredAccounts)" key="SOFTWARE\Policies\GGEmail" valueName="PreconfiguredAccounts">
      <parentCategory ref="GGEmail_Accounts" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <text id="PreconfiguredAccounts_Value" valueName="PreconfiguredAccounts" required="false" />
      </elements>
    </policy>
    <policy name="AllowAccountManagement" class="Both" displayName="$(string.AllowAccountManagement)" explainText="$(string.AllowAccountManagement_Help)" key="SOFTWARE\Policies\GGEmail" valueName="AllowAccountManagement">
      <parentCategory ref="GGEmail_Accounts" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="AllowOAuth" class="Both" displayName="$(string.AllowOAuth)" explainText="$(string.AllowOAuth_Help)" key="SOFTWARE\Policies\GGEmail" valueName="AllowOAuth">
      <parentCategory ref="GGEmail_Accounts" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="GoogleClientId" class="Both" displayName="$(string.GoogleClientId)" explainText="$(string.GoogleClientId_Help)" presentation="$(presentation.GoogleClientId)" key="SOFTWARE\Policies\GGEmail" valueName="GoogleClientId">
      <parentCategory ref="GGEmail_Accounts" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <text id="GoogleClientId_Value" valueName="GoogleClientId" required="false" />
      </elements>
    </policy>
    <policy name="YandexClientId" class="Both" displayName="$(string.YandexClientId)" explainText="$(string.YandexClientId_Help)" presentation="$(presentation.YandexClientId)" key="SOFTWARE\Policies\GGEmail" valueName="YandexClientId">
      <parentCategory ref="GGEmail_Accounts" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <text id="YandexClientId_Value" valueName="YandexClientId" required="false" />
      </elements>
    </policy>
    <policy name="UpdateMode" class="Both" displayName="$(string.UpdateMode)" explainText="$(string.UpdateMode_Help)" presentation="$(presentation.UpdateMode)" key="SOFTWARE\Policies\GGEmail" valueName="UpdateMode">
      <parentCategory ref="GGEmail_Updates" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <enum id="UpdateMode_Value" valueName="UpdateMode" required="false">
          <item displayName="$(string.UpdateMode_auto)">
            <value><string>auto</string></value>
          </item>
          <item displayName="$(string.UpdateMode_notify)">
            <value><string>notify</string></value>
          </item>
          <item displayName="$(string.UpdateMode_disabled)">
            <value><string>disabled</string></value>
          </item>
        </enum>
      </elements>
    </policy>
    <policy name="UpdateChannel" class="Both" displayName="$(string.UpdateChannel)" explainText="$(string.UpdateChannel_Help)" presentation="$(presentation.UpdateChannel)" key="SOFTWARE\Policies\GGEmail" valueName="UpdateChannel">
      <parentCategory ref="GGEmail_Updates" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <enum id="UpdateChannel_Value" valueName="UpdateChannel" required="false">
          <item displayName="$(string.UpdateChannel_stable)">
            <value><string>stable</string></value>
          </item>
          <item displayName="$(string.UpdateChannel_beta)">
            <value><string>beta</string></value>
          </item>
          <item displayName="$(string.UpdateChannel_internal)">
            <value><string>internal</string></value>
          </item>
        </enum>
      </elements>
    </policy>
    <policy name="UpdateBaseUrl" class="Both" displayName="$(string.UpdateBaseUrl)" explainText="$(string.UpdateBaseUrl_Help)" presentation="$(presentation.UpdateBaseUrl)" key="SOFTWARE\Policies\GGEmail" valueName="UpdateBaseUrl">
      <parentCategory ref="GGEmail_Updates" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <text id="UpdateBaseUrl_Value" valueName="UpdateBaseUrl" required="false" />
      </elements>
    </policy>
    <policy name="UpdateCheckIntervalHours" class="Both" displayName="$(string.UpdateCheckIntervalHours)" explainText="$(string.UpdateCheckIntervalHours_Help)" presentation="$(presentation.UpdateCheckIntervalHours)" key="SOFTWARE\Policies\GGEmail" valueName="UpdateCheckIntervalHours">
      <parentCategory ref="GGEmail_Updates" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <decimal id="UpdateCheckIntervalHours_Value" valueName="UpdateCheckIntervalHours" minValue="1" maxValue="168" />
      </elements>
    </policy>
    <policy name="UpdateDeferDays" class="Both" displayName="$(string.UpdateDeferDays)" explainText="$(string.UpdateDeferDays_Help)" presentation="$(presentation.UpdateDeferDays)" key="SOFTWARE\Policies\GGEmail" valueName="UpdateDeferDays">
      <parentCategory ref="GGEmail_Updates" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <decimal id="UpdateDeferDays_Value" valueName="UpdateDeferDays" minValue="0" maxValue="30" />
      </elements>
    </policy>
    <policy name="BlockRemoteContent" class="Both" displayName="$(string.BlockRemoteContent)" explainText="$(string.BlockRemoteContent_Help)" key="SOFTWARE\Policies\GGEmail" valueName="BlockRemoteContent">
      <parentCategory ref="GGEmail_Security" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="AllowHtmlMail" class="Both" displayName="$(string.AllowHtmlMail)" explainText="$(string.AllowHtmlMail_Help)" key="SOFTWARE\Policies\GGEmail" valueName="AllowHtmlMail">
      <parentCategory ref="GGEmail_Security" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="BlockedAttachmentExtensions" class="Both" displayName="$(string.BlockedAttachmentExtensions)" explainText="$(string.BlockedAttachmentExtensions_Help)" presentation="$(presentation.BlockedAttachmentExtensions)" key="SOFTWARE\Policies\GGEmail" valueName="BlockedAttachmentExtensions">
      <parentCategory ref="GGEmail_Security" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <multiText id="BlockedAttachmentExtensions_Value" valueName="BlockedAttachmentExtensions" />
      </elements>
    </policy>
    <policy name="RequireTls" class="Both" displayName="$(string.RequireTls)" explainText="$(string.RequireTls_Help)" key="SOFTWARE\Policies\GGEmail" valueName="RequireTls">
      <parentCategory ref="GGEmail_Security" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="MaxCacheSizeMb" class="Both" displayName="$(string.MaxCacheSizeMb)" explainText="$(string.MaxCacheSizeMb_Help)" presentation="$(presentation.MaxCacheSizeMb)" key="SOFTWARE\Policies\GGEmail" valueName="MaxCacheSizeMb">
      <parentCategory ref="GGEmail_Storage" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <decimal id="MaxCacheSizeMb_Value" valueName="MaxCacheSizeMb" minValue="256" maxValue="65536" />
      </elements>
    </policy>
    <policy name="CacheRetentionDays" class="Both" displayName="$(string.CacheRetentionDays)" explainText="$(string.CacheRetentionDays_Help)" presentation="$(presentation.CacheRetentionDays)" key="SOFTWARE\Policies\GGEmail" valueName="CacheRetentionDays">
      <parentCategory ref="GGEmail_Storage" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <decimal id="CacheRetentionDays_Value" valueName="CacheRetentionDays" minValue="30" maxValue="3650" />
      </elements>
    </policy>
    <policy name="SyncIntervalMinutes" class="Both" displayName="$(string.SyncIntervalMinutes)" explainText="$(string.SyncIntervalMinutes_Help)" presentation="$(presentation.SyncIntervalMinutes)" key="SOFTWARE\Policies\GGEmail" valueName="SyncIntervalMinutes">
      <parentCategory ref="GGEmail_Storage" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <decimal id="SyncIntervalMinutes_Value" valueName="SyncIntervalMinutes" minValue="1" maxValue="120" />
      </elements>
    </policy>
    <policy name="DefaultLanguage" class="Both" displayName="$(string.DefaultLanguage)" explainText="$(string.DefaultLanguage_Help)" presentation="$(presentation.DefaultLanguage)" key="SOFTWARE\Policies\GGEmail" valueName="DefaultLanguage">
      <parentCategory ref="GGEmail_Interface" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <enum id="DefaultLanguage_Value" valueName="DefaultLanguage" required="false">
          <item displayName="$(string.DefaultLanguage_auto)">
            <value><string>auto</string></value>
          </item>
          <item displayName="$(string.DefaultLanguage_ru)">
            <value><string>ru</string></value>
          </item>
          <item displayName="$(string.DefaultLanguage_en)">
            <value><string>en</string></value>
          </item>
        </enum>
      </elements>
    </policy>
    <policy name="ShowPolicyBanner" class="Both" displayName="$(string.ShowPolicyBanner)" explainText="$(string.ShowPolicyBanner_Help)" key="SOFTWARE\Policies\GGEmail" valueName="ShowPolicyBanner">
      <parentCategory ref="GGEmail_Interface" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="LogLevel" class="Both" displayName="$(string.LogLevel)" explainText="$(string.LogLevel_Help)" presentation="$(presentation.LogLevel)" key="SOFTWARE\Policies\GGEmail" valueName="LogLevel">
      <parentCategory ref="GGEmail_Diagnostics" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <enum id="LogLevel_Value" valueName="LogLevel" required="false">
          <item displayName="$(string.LogLevel_error)">
            <value><string>error</string></value>
          </item>
          <item displayName="$(string.LogLevel_warn)">
            <value><string>warn</string></value>
          </item>
          <item displayName="$(string.LogLevel_info)">
            <value><string>info</string></value>
          </item>
          <item displayName="$(string.LogLevel_debug)">
            <value><string>debug</string></value>
          </item>
        </enum>
      </elements>
    </policy>
    <policy name="TelemetryEnabled" class="Both" displayName="$(string.TelemetryEnabled)" explainText="$(string.TelemetryEnabled_Help)" key="SOFTWARE\Policies\GGEmail" valueName="TelemetryEnabled">
      <parentCategory ref="GGEmail_Diagnostics" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
  </policies>
</policyDefinitions>
